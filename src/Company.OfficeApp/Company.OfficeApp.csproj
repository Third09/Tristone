<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Company.Shared\Company.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Part of Tri-Stone (Company.Launcher), the one program staff open: it signs people in and opens these office
         screens or the Website Admin screens. Not started on its own (owner request 2026-10-30). -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ScottPlot.WinForms also brings an optional OpenGL control built for .NET Framework (NU1701 warning).
         The normal FormsPlot used for the Dashboard chart doesn't use it. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tri-Stone Website Admin: the screens for managing the public website. Not started on its own: the Tri-Stone
    launcher (Company.Launcher) signs people in once and opens this for Website Admin logins (and Admins who choose it).
    One account list with the office app (owner decision 2026-10-30, script 011), so it uses the office app's
    sign-in, session, database settings and screen helpers directly.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Company.Shared\Company.Shared.csproj" />
    <ProjectReference Include="..\Company.OfficeApp\Company.OfficeApp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
